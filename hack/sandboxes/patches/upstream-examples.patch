index 0000000..e6cd2bd
--- /dev/null
+++ b/cookbook/scripts/lib/renderer-examples.test.ts
@@ -0,0 +1,58 @@
+import { describe, expect, it } from 'vitest';
+import { applyRendererProfile } from './renderer-profile.ts';
+
+describe('reviewed renderer examples', () => {
+  it('counts additions separately from replacements and is idempotent', () => {
+    const request = { schema: {}, example: { kits: [{}] } };
+    const created: Record<string, unknown> = { schema: {} };
+    const pending = { schema: {}, examples: { old: { value: {} } } };
+    const doc = {
+      paths: {
+        '/v1/sandboxes': {
+          post: {
+            operationId: 'createSandbox',
+            requestBody: { content: { 'application/json': request } },
+            responses: {
+              '201': { content: { 'application/json': created } },
+              '202': { content: { 'application/json': pending } },
+            },
+          },
+        },
+      },
+    };
+    expect(applyRendererProfile(doc).examples).toBe(1);
+    expect(request.example).toEqual({
+      displayName: 'my-sandbox', imageRef: 'ubuntu:24.04',
+    });
+    expect(pending).not.toHaveProperty('examples');
+    expect(created.example).toMatchObject({
+      core: { status: 'running', etag: '"example-version"' },
+    });
+    expect(pending).toHaveProperty('example.core.status', 'creating');
+    const first = structuredClone(doc);
+    expect(applyRendererProfile(doc).examples).toBe(0);
+    expect(doc).toEqual(first);
+  });
+
+  it('preserves unrelated examples and does not add response bodies', () => {
+    const doc = {
+      paths: {
+        '/v1/sandboxes/{sandbox}': {
+          delete: {
+            operationId: 'deleteSandbox',
+            responses: { '204': { description: 'Deleted' } },
+          },
+          get: {
+            operationId: 'unrelatedOperation',
+            responses: {
+              '200': { content: { 'application/json': { example: { value: 42 } } } },
+            },
+          },
+        },
+      },
+    };
+    const before = structuredClone(doc);
+    expect(applyRendererProfile(doc).examples).toBe(0);
+    expect(doc.paths).toEqual(before.paths);
+  });
+});
diff --git a/cookbook/scripts/lib/renderer-examples.ts b/cookbook/scripts/lib/renderer-examples.ts
new file mode 100644
index 0000000..b613404
--- /dev/null
+++ b/cookbook/scripts/lib/renderer-examples.ts
@@ -0,0 +1,93 @@
+// Concrete bodies for schemas whose unions and lifecycle constraints cannot
+// be illustrated by synthesizing each property independently.
+type Node = Record<string, unknown>;
+const createdAt = '2026-01-01T00:00:00Z';
+const etag = '"example-version"';
+const resource = (collection: string, uid: string) => ({
+  name: `${collection}/${uid}`, uid, createdAt, etag,
+});
+const sandbox = (status: string) => ({
+  name: 'sandboxes/sbx_example', uid: 'sbx_example',
+  core: { status, createdAt, etag },
+});
+const image = (status: string) => ({
+  ...resource('images', 'img_example'), status, updatedAt: createdAt,
+});
+const snapshot = (status: string) => ({
+  ...resource('snapshots', 'snap_example'), status,
+  sandbox: 'sandboxes/sbx_example',
+});
+const secret = {
+  ...resource('secrets', 'sec_example'), updatedAt: createdAt, type: 'token',
+};
+const networkPolicy = {
+  effective: { mode: 'allowAll' },
+  exact: {
+    revision: 'example-revision', selectorVersion: 'destination.v1',
+    nodes: [{ constant: 'true', source: { origin: 'organization', id: 'example-org' } }],
+  },
+};
+
+// Keys are operation IDs, then request or HTTP response status.
+const examples: Record<string, Record<string, Node>> = {
+  createImage: {
+    request: { displayName: 'my-image', fromImage: {} },
+    '201': image('completed'), '202': image('preparing'),
+  },
+  getImage: { '200': image('completed') },
+  createSandbox: {
+    request: { displayName: 'my-sandbox', imageRef: 'ubuntu:24.04' },
+    '201': sandbox('running'), '202': sandbox('creating'),
+  },
+  getSandbox: { '200': sandbox('running') },
+  updateSandbox: { '200': sandbox('running') },
+  renewSandboxTimeout: { '200': sandbox('running') },
+  deleteSandbox: { '202': sandbox('deleting') },
+  startSandbox: { '200': sandbox('running'), '202': sandbox('starting') },
+  stopSandbox: { '200': sandbox('stopped'), '202': sandbox('stopping') },
+  restoreSnapshot: { '201': sandbox('running'), '202': sandbox('creating') },
+  createSnapshot: { '201': snapshot('ready'), '202': snapshot('creating') },
+  getSnapshot: { '200': snapshot('ready') },
+  createSecret: {
+    request: { displayName: 'service-token', token: { value: 'example-token' } },
+    '201': secret,
+  },
+  updateSecret: {
+    request: { token: { value: 'replacement-example-token' } }, '200': secret,
+  },
+  getSecret: { '200': secret },
+  createVolume: { '201': resource('volumes', 'vol_example') },
+  getVolume: { '200': resource('volumes', 'vol_example') },
+  authorizeMcpServer: {
+    '202': {
+      server: 'mcp-servers/example', status: 'pending',
+      authorizationUrl: 'https://example.com/authorize',
+    },
+  },
+  startMcpGateway: { '202': { state: 'provisioning', reused: false } },
+  getNetworkPolicies: { '200': networkPolicy },
+  getNetworkPoliciesInOwnerScope: { '200': networkPolicy },
+};
+
+/** Set reviewed JSON examples and return the number of newly covered bodies. */
+export function applyReviewedExamples(doc: Node): number {
+  let added = 0;
+  const paths = (doc.paths ?? {}) as Record<string, Record<string, Node>>;
+  for (const item of Object.values(paths)) {
+    for (const operation of Object.values(item)) {
+      const bodies = examples[String(operation?.operationId ?? '')];
+      if (!bodies) continue;
+      for (const [status, example] of Object.entries(bodies)) {
+        const body = status === 'request'
+          ? operation.requestBody
+          : (operation.responses as Node)?.[status];
+        const media = ((body as Node)?.content as Node)?.['application/json'] as Node | undefined;
+        if (!media) continue;
+        if (!('example' in media) && !('examples' in media)) added += 1;
+        delete media.examples;
+        media.example = structuredClone(example);
+      }
+    }
+  }
+  return added;
+}
